{
  "name": "st4s",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot server/local-pg/entry.ts dev",
    "test": "NODE_ENV=test bun test tests",
    "build": "react-router build",
    "start": "NODE_ENV=production bun run server/local-pg/entry.ts prod",
    "smoke:prod": "bun run build && bun scripts/smoke-server.ts bun run server/prod.ts",
    "smoke:binary": "bun run build:binary && bun scripts/smoke-server.ts ./st4s",
    "smoke:coldboot": "bun run build:binary && bun scripts/smoke-coldboot.ts ./st4s",
    "build:binary": "react-router build && bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --asset ./build/client --asset ./server/db/migrations --define process.env.NODE_ENV=process.env.NODE_ENV --minify server/binary-entry.ts --outfile st4s",
    "build:binary:linux": "react-router build && bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --asset ./build/client --asset ./server/db/migrations --define process.env.NODE_ENV=process.env.NODE_ENV --minify --target=bun-linux-x64 server/binary-entry.ts --outfile st4s-linux-x64",
    "build:binary:linux-musl": "react-router build && bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --asset ./build/client --asset ./server/db/migrations --define process.env.NODE_ENV=process.env.NODE_ENV --minify --target=bun-linux-x64-musl server/binary-entry.ts --outfile st4s-linux-musl",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "bunx @better-auth/cli generate --output server/db/auth.schema.ts",
    "admin:verify": "bun scripts/verify-super-admin.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.3",
    "@dagrejs/dagre": "^3.1.1",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/node": "^1.4.5",
    "@elysiajs/static": "^1.4.10",
    "@mantine/core": "^9.6.0",
    "@mantine/form": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/modals": "^9.6.1",
    "@mantine/notifications": "^9.6.1",
    "@mantine/nprogress": "^9.6.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@react-router/dev": "^8.3.1",
    "@react-router/node": "^8.3.1",
    "@sinclair/typebox": "^0.34.52",
    "@tanstack/react-query": "^5.102.8",
    "@xyflow/react": "^12.11.6",
    "better-auth": "^1.7.3",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "elysia-mcp": "^0.1.1",
    "isbot": "^5.2.2",
    "onnxruntime-node": "1.30.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router": "^8.3.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "^1.4.1",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "openai": "7.27.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "ws": "8.22.0"
  }
}
