{
  "mcpServers": {
    "st4s-debug-staging": {
      "type": "http",
      "url": "https://staging.your-app.example.com/api/mcp",
      "headers": {
        "Authorization": "Bearer ${ST4S_MCP_KEY}"
      }
    },
    "st4s-debug-prod": {
      "type": "http",
      "url": "https://your-app.example.com/api/mcp",
      "headers": {
        "Authorization": "Bearer ${ST4S_MCP_KEY}"
      }
    }
  }
}
