# App
NODE_ENV=development
# Note: pick a free port. On this machine :3000 is taken by another container.
PORT=3005
APP_URL=http://localhost:3005

# Database — point at your Postgres instance.
DATABASE_URL=postgres://makuro:makuro@localhost:5432/makuro

# Better Auth
# generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-run-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3005

# Google OAuth (optional) — set both to show "Lanjutkan dengan Google" on /login.
# Authorized redirect URI to register in Google Cloud Console:
#   ${BETTER_AUTH_URL}/api/auth/callback/google
# BETTER_AUTH_URL must be the origin the app is served from (same port as PORT in dev).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Super admins — comma-separated emails. These accounts are always super-admin
# and can access /dev. Add/remove emails here to grant/revoke (applied on next
# login). Granted only to a VERIFIED email (Google sign-in, or email_verified set
# in the DB; no verification email is sent).
# Example: SUPER_ADMIN_EMAILS=you@example.com,cofounder@example.com
SUPER_ADMIN_EMAILS=

# AUTH_DISABLE_SIGNUP: 'true' closes sign-up, 'false' opens it.
# Unset = closed when NODE_ENV=production (binary too), open in dev/test.
# Closed = no NEW accounts via email+password or Google, except Google sign-in
# by an email in SUPER_ADMIN_EMAILS. Existing users keep signing in either way.
# Empty = default by NODE_ENV (above).
AUTH_DISABLE_SIGNUP=

# MCP debug server — expose /api/mcp for local agent access to logs, DB, and status.
# Leave empty to disable. Generate: openssl rand -hex 32
# Access via:
#   Bearer:     Authorization: Bearer <token>
#   Query param: /api/mcp?mcpAdminToken=<token>  (e.g. for stream URLs)
MCP_ADMIN_TOKEN=

# API rate limit per client IP (sliding window). Defaults: 100 requests / 60000 ms.
# /api/auth/* (Better Auth) and /api/mcp (token-protected) are never limited.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Reverse proxies whose X-Forwarded-For / X-Real-IP are believed (comma list of IPs/CIDRs;
# "loopback" = 127.0.0.0/8 + ::1). Empty (default) = forwarding headers ignored, socket IP used.
# Behind nginx/caddy on the same host: TRUSTED_PROXIES=loopback
TRUSTED_PROXIES=

# ── Speech engines (lazy: a child process + model load on the first request) ──
# STT — Qwen3-ASR via libcrispasr (bun:ffi). Empty path = default under ~/.cache/crispasr.
# CRISPASR_LIB: libcrispasr shared library. Default ~/tmp/stt/build/src/libcrispasr.dylib
CRISPASR_LIB=
# STT_MODEL: Qwen3-ASR GGUF. Default ~/.cache/crispasr/qwen3-asr-1.7b-q4_k.gguf
STT_MODEL=
# STT_VAD_MODEL: Silero VAD used to slice audio. Default ~/.cache/crispasr/ggml-silero-v6.2.0.bin.
# Unset = default; set to an EMPTY value to disable slicing (one pass, single stream delta).
# STT_VAD_MODEL=
# STT_LID_MODEL: whisper ggml model for language ID when language is "auto". Default ~/.cache/crispasr/ggml-tiny.bin
STT_LID_MODEL=
# STT_THREADS: decoder threads (default 4).
STT_THREADS=4
# STT_GPU: 1 = Metal decode (falls back to CPU). Default off: libcrispasr loads the GGUF a second time on the
# first request and on Apple Silicon the GPU path wires both copies outside the process RSS (8 GB host: free RAM
# 77% -> 14% in ~1.5 s). CPU keeps that memory pageable at a comparable RTF.
STT_GPU=
# STT_MAX_QUEUE: waiting requests before the API answers 429 engine_busy (default 4).
STT_MAX_QUEUE=4
# STT_IDLE_TIMEOUT_SEC: unload the model after this idle time, 0 = never (default 600).
STT_IDLE_TIMEOUT_SEC=600
# STT_DEFAULT_LANGUAGE: language when the request omits it (default id).
STT_DEFAULT_LANGUAGE=id
# STT_MAX_CHUNK_SEC: longest VAD slice in seconds, bounds decoder memory (default 30).
STT_MAX_CHUNK_SEC=30

# TTS — Supertonic 3 via onnxruntime-node.
# TTS_MODEL_DIR: directory with onnx/ and voice_styles/. Default ~/.wibu/tts/model
TTS_MODEL_DIR=
# TTS_STEPS: denoising steps when the request gives none (default 8).
TTS_STEPS=8
# TTS_THREADS: onnxruntime intra-op threads, 0 = onnxruntime default (default 0).
TTS_THREADS=0
# TTS_MAX_QUEUE: waiting requests before the API answers 429 engine_busy (default 8).
TTS_MAX_QUEUE=8
# TTS_IDLE_TIMEOUT_SEC: unload the model after this idle time, 0 = never (default 600).
TTS_IDLE_TIMEOUT_SEC=600
# TTS_DEFAULT_LANGUAGE: language when /v1/audio/speech omits `language` (default id).
TTS_DEFAULT_LANGUAGE=id
# TTS_MAX_UNIT_CHARS: longest text unit sent to the engine in one call (default 400).
TTS_MAX_UNIT_CHARS=400
# TTS_FFMPEG_TIMEOUT_MS: idle timeout for the mp3/opus/aac/flac ffmpeg encoder — killed only after this long
# without new audio in or out, so long streams are not cut (default 120000).
TTS_FFMPEG_TIMEOUT_MS=120000
# FFMPEG_PATH: ffmpeg used to decode non-WAV uploads and encode mp3/opus/aac/flac (default "ffmpeg" on PATH).
FFMPEG_PATH=

# Memory guard — protects an 8 GB host from swap/OOM while engines run. Percent = free RAM (darwin memorystatus
# level, Linux MemAvailable); kernel pressure "critical" counts as CRITICAL. Order must be EMERGENCY < CRITICAL < WARN
# < RECOVER or the server refuses to boot. Unloaded engines are never reloaded automatically.
# MEM_GUARD_ENABLED: false disables the guard entirely (default true).
MEM_GUARD_ENABLED=true
# MEM_GUARD_WARN_PCT: below this, new /api/v1/audio/* and warmup requests get 503 memory_pressure (default 30).
MEM_GUARD_WARN_PCT=30
# MEM_GUARD_CRITICAL_PCT: below this, idle engines are unloaded, then busy ones on the next tick (default 20).
MEM_GUARD_CRITICAL_PCT=20
# MEM_GUARD_EMERGENCY_PCT: below this, STT then TTS are unloaded immediately (default 12).
MEM_GUARD_EMERGENCY_PCT=12
# MEM_GUARD_RECOVER_PCT / MEM_GUARD_RECOVER_SEC: shedding stops once free RAM stays ≥ this for this long (default 40 / 30).
MEM_GUARD_RECOVER_PCT=40
MEM_GUARD_RECOVER_SEC=30
# MEM_GUARD_COOLDOWN_SEC: minimum gap between CRITICAL unloads, so freed RAM can show up first (default 3).
MEM_GUARD_COOLDOWN_SEC=3
# MEM_BUDGET_STT_MB / MEM_BUDGET_TTS_MB: free RAM (MB) a cold load needs; below it the request/warmup that would load
# the engine gets 503 memory_pressure. Loaded engines are never checked; 0 disables (default 2600 / 600).
MEM_BUDGET_STT_MB=2600
MEM_BUDGET_TTS_MB=600

# /api/v1 (OpenAI-compatible) limits for /v1/audio/transcriptions.
# V1_MAX_UPLOAD_MB: larger uploads get 413 (default 25).
V1_MAX_UPLOAD_MB=25
# V1_MAX_AUDIO_SEC: longer audio gets 400 (default 1800).
V1_MAX_AUDIO_SEC=1800
# V1_FFMPEG_TIMEOUT_MS: ffmpeg decode is killed after this (default 120000).
V1_FFMPEG_TIMEOUT_MS=120000
# V1_DECODE_CONCURRENCY: uploads decoded at once; a request waiting longer than V1_DECODE_WAIT_MS (default 5000) gets 429 (default 2).
V1_DECODE_CONCURRENCY=2
