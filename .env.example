# App
NODE_ENV=development
# Note: pick a free port. On this machine :3000 is taken by another container.
PORT=3005
APP_URL=http://localhost:3005

# Database — point at your Postgres instance.
DATABASE_URL=postgres://makuro:makuro@localhost:5432/makuro

# Better Auth
# generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-run-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3005

# Super admins — comma-separated emails. These accounts are always super-admin
# and can access /dev. Add/remove emails here to grant/revoke (applied on next
# login). Example: SUPER_ADMIN_EMAILS=you@example.com,cofounder@example.com
SUPER_ADMIN_EMAILS=

# MCP debug server — expose /api/mcp for local agent access to logs, DB, and status.
# Leave empty to disable. Generate: openssl rand -hex 32
# Access via:
#   Bearer:     Authorization: Bearer <token>
#   Query param: /api/mcp?mcpAdminToken=<token>  (e.g. for stream URLs)
MCP_ADMIN_TOKEN=

# API rate limit per client IP (sliding window). Defaults: 100 requests / 60000 ms.
# /api/auth/* (Better Auth) and /api/mcp (token-protected) are never limited.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── Speech engines (lazy: a child process + model load on the first request) ──
# STT — Qwen3-ASR via libcrispasr (bun:ffi). Empty path = default under ~/.cache/crispasr.
# CRISPASR_LIB: libcrispasr shared library. Default ~/tmp/stt/build/src/libcrispasr.dylib
CRISPASR_LIB=
# STT_MODEL: Qwen3-ASR GGUF. Default ~/.cache/crispasr/qwen3-asr-1.7b-q4_k.gguf
STT_MODEL=
# STT_VAD_MODEL: Silero VAD used to slice audio. Default ~/.cache/crispasr/ggml-silero-v6.2.0.bin.
# Unset = default; set to an EMPTY value to disable slicing (one pass, single stream delta).
# STT_VAD_MODEL=
# STT_LID_MODEL: whisper ggml model for language ID when language is "auto". Default ~/.cache/crispasr/ggml-tiny.bin
STT_LID_MODEL=
# STT_THREADS: decoder threads (default 4).
STT_THREADS=4
# STT_MAX_QUEUE: waiting requests before 503 busy (default 4).
STT_MAX_QUEUE=4
# STT_IDLE_TIMEOUT_SEC: unload the model after this idle time, 0 = never (default 600).
STT_IDLE_TIMEOUT_SEC=600
# STT_DEFAULT_LANGUAGE: language when the request omits it (default id).
STT_DEFAULT_LANGUAGE=id
# STT_MAX_CHUNK_SEC: longest VAD slice in seconds, bounds decoder memory (default 30).
STT_MAX_CHUNK_SEC=30

# TTS — Supertonic 3 via onnxruntime-node.
# TTS_MODEL_DIR: directory with onnx/ and voice_styles/. Default ~/.wibu/tts/model
TTS_MODEL_DIR=
# TTS_STEPS: denoising steps when the request gives none (default 8).
TTS_STEPS=8
# TTS_THREADS: onnxruntime intra-op threads, 0 = onnxruntime default (default 0).
TTS_THREADS=0
# TTS_MAX_QUEUE: waiting requests before 503 busy (default 8).
TTS_MAX_QUEUE=8
# TTS_IDLE_TIMEOUT_SEC: unload the model after this idle time, 0 = never (default 600).
TTS_IDLE_TIMEOUT_SEC=600
# TTS_DEFAULT_LANGUAGE: language when /v1/audio/speech omits `language` (default id).
TTS_DEFAULT_LANGUAGE=id
# TTS_MAX_UNIT_CHARS: longest text unit sent to the engine in one call (default 400).
TTS_MAX_UNIT_CHARS=400
# TTS_FFMPEG_TIMEOUT_MS: hard cap on one ffmpeg encode for mp3/opus/aac/flac (default 120000).
TTS_FFMPEG_TIMEOUT_MS=120000
# FFMPEG_PATH: ffmpeg used by /v1/audio/speech to encode (default "ffmpeg" on PATH).
FFMPEG_PATH=

# /api/v1 (OpenAI-compatible) limits for /v1/audio/transcriptions.
# V1_MAX_UPLOAD_MB: larger uploads get 413 (default 25).
V1_MAX_UPLOAD_MB=25
# V1_MAX_AUDIO_SEC: longer audio gets 400 (default 1800).
V1_MAX_AUDIO_SEC=1800
# V1_FFMPEG_PATH: ffmpeg used to decode non-WAV uploads (default "ffmpeg" on PATH).
V1_FFMPEG_PATH=
# V1_FFMPEG_TIMEOUT_MS: ffmpeg decode is killed after this (default 120000).
V1_FFMPEG_TIMEOUT_MS=120000
